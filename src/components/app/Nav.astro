---
import icon from "../../assets/icon.svg"
const pathname = new URL(Astro.request.url).pathname
const currentPath = pathname.slice(1)
---

<nav id="nav">
	<a href="/" class="icon"><img src={icon.src} alt="abide OS" /></a>
	<ul>
		<li>
			<a class={currentPath === "" ? "active" : ""} href="/">Tableau de bord</a>
		</li>
		<li>
			<a class={currentPath.includes("songs") ? "active" : ""} href="/songs"
				>Morceaux</a
			>
		</li>
		<li>
			<a
				class={currentPath.includes("setlists") ? "active" : ""}
				href="/setlists">Setlists</a
			>
		</li>
		<li>
			<a class={currentPath === "shows" ? "active" : ""} href="/shows"
				>Concerts</a
			>
		</li>
		<li>
			<a class={currentPath.includes("tasks") ? "active" : ""} href="/tasks"
				>Tâches</a
			>
		</li>
	</ul>
</nav>

<style>
	.icon {
		display: block;
		width: 60px;
		height: 60px;
		text-align: center;
		margin: 1.5rem auto 2rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	li {
		margin: 0;
		text-align: center;
	}
	li a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--fg);
		text-decoration: none;
		height: 44px;
		border: 1px solid transparent;
	}
	li a:hover {
		color: var(--bg);
		background-color: var(--fg);
	}
	li a:active {
		color: var(--bg);
		background-color: var(--fg);
	}

	li a.active {
		border-color: var(--fg);
	}
</style>
