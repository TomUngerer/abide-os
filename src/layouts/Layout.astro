---
import Footer from "../components/app/Footer.astro"
import Header from "../components/app/Header.astro"
import Sidebar from "../components/app/Sidebar.astro"
import "../styles/global.css"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- <link rel="icon" href="/favicon.ico" /> -->
		<meta name="generator" content={Astro.generator} />
		<title>abide OS</title>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header back={Astro.props.back} />
		<Sidebar />
		<div id="overlay"></div>
		<div id="container">
			<main id="main-content">
				<slot />
			</main>
		</div>
		<Footer />
	</body>
</html>

<style is:global>
	#container {
		height: 100%;
		padding-top: 60px;
		padding-left: 250px;
	}

	main {
		height: 100%;
		padding: 2rem;
		width: 100%;
		overflow-y: scroll;
	}

	#overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.75);
		z-index: 99;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease-in-out;
	}

	#overlay.open {
		opacity: 1;
		pointer-events: auto;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 200;
		background: var(--fg);
		color: var(--bg);
		padding: 0.75rem 1rem;
		text-decoration: none;
	}

	.skip-link:focus {
		left: 1rem;
		top: 1rem;
	}

	@media screen and (max-width: 1200px) {
		#container {
			padding-bottom: 72px;
		}
	}

	@media screen and (max-width: 840px) {
		#container {
			padding-left: 0;
			height: 100%;
		}
		#overlay {
			display: block;
		}
	}
</style>
